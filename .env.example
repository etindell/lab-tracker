# Lab Tracker Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME=Lab Tracker
ENVIRONMENT=development  # development, staging, production
DEBUG=false

# Database - PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://labtracker:password@localhost:5432/labtracker

# Security
# IMPORTANT: Generate a strong secret key for production!
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# Session expiration (in seconds)
SESSION_EXPIRE_SECONDS=86400  # 24 hours default
SESSION_EXPIRE_REMEMBER_SECONDS=2592000  # 30 days for "remember me"

# Server
HOST=0.0.0.0
PORT=8000
